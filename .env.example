# Backend Configuration (backend/.env)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Database & Redis (Docker services)
DATABASE_URL="postgresql://velozity:velozity@localhost:5432/velozity_dashboard?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication Secrets
JWT_ACCESS_SECRET="velozity-super-secret-access-token-key-2026"
JWT_REFRESH_SECRET="velozity-super-secret-refresh-token-key-2026"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Frontend Configuration (frontend/.env)
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="http://localhost:4000"
